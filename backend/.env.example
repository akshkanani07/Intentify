# Intentify Environment Configuration

APP_NAME=Intentify
VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
PROMPT_INJECTION_STRICT_MODE=true

# Database & Cache
DATABASE_URL=postgresql+asyncpg://intentify:intentify_secret@localhost:5432/intentify
REDIS_URL=redis://localhost:6379/0

# Paths
KNOWLEDGE_BASE_DIR=../knowledge-base
MODEL_DIR=../ml-engine/models

# ML Parameters
EMBEDDING_MODEL_NAME=multilingual-e5-small
QUALITY_SCORE_THRESHOLD=85.0
MAX_AUTO_IMPROVE_ITERATIONS=3

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
